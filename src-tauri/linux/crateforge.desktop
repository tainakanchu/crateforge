{{!--
  Linux (deb / rpm / AppImage) 用の .desktop テンプレート。Tauri 既定のテンプレートとの違い:
  - Exec に %F を付ける: ファイルマネージャの「このアプリで開く」/ 既定のアプリで開いたファイルを
    引数で受け取るため (既定テンプレートの Exec には引数が無い)。
  - MimeType は tauri.conf.json の fileAssociations (1 拡張子 1 MIME) に加え、
    shared-mime-info の別名 (audio/x-flac や audio/x-vorbis+ogg 等) も並べる。
    拡張子の集合は tauri.conf.json / src-tauri/src/open_with.rs の OPEN_WITH_EXTENSIONS と揃えること。
--}}
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %F
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
MimeType=audio/mpeg;audio/x-mp3;audio/mp3;audio/flac;audio/x-flac;audio/x-wav;audio/wav;audio/vnd.wave;audio/x-aiff;audio/aiff;audio/mp4;audio/x-m4a;audio/aac;audio/x-aac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;
