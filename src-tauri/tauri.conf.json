{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Crateforge",
  "version": "0.19.0",
  "identifier": "com.tainakanchu.crateforge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Crateforge",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 Audio",
        "description": "MP3 Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC Audio",
        "description": "FLAC Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAV Audio",
        "description": "WAV Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/x-wav"
      },
      {
        "ext": [
          "aiff",
          "aif"
        ],
        "name": "AIFF Audio",
        "description": "AIFF Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/x-aiff"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "MPEG-4 Audio",
        "description": "MPEG-4 Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "aac"
        ],
        "name": "AAC Audio",
        "description": "AAC Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/aac"
      },
      {
        "ext": [
          "ogg"
        ],
        "name": "Ogg Vorbis Audio",
        "description": "Ogg Vorbis Audio",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "audio/ogg"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/crateforge.desktop",
        "depends": ["libdiscid0"]
      },
      "rpm": {
        "desktopTemplate": "linux/crateforge.desktop",
        "depends": ["libdiscid"]
      }
    }
  }
}
